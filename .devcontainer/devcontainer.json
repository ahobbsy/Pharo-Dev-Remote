{
  "name": "Pharo Cloud Smalltalk Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  
  // Install the lightweight VNC desktop environment
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "pharo",
      "webPort": "6080"
    }
  },

  // Ports to expose. 6080 is the standard web client for noVNC
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Pharo Desktop UI",
      "onAutoForward": "openBrowser"
    }
  },

  // Install the official 64-bit Pharo VM after the container is created.
  "postCreateCommand": "bash .devcontainer/setup-pharo.sh",

  // Open the checked-in image whenever the desktop container starts.
  "postStartCommand": "bash .devcontainer/start-pharo.sh"
}
